{
  "name": "flywheel-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.browser-tests.json && vite build && node ../../scripts/release/check-release-bundle.mjs dist",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "e2e": "node e2e/run.mjs",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:dark": "vitest run --config vitest.browser.dark.config.ts",
    "test:browser:motion": "vitest run --config vitest.browser.motion.config.ts",
    "test:browser:forced-colors": "vitest run --config vitest.browser.forced-colors.config.ts",
    "test:browser:arms": "node scripts/run-browser-arms.mjs",
    "test:critique": "CRITIQUE_SHOTS=1 CRITIQUE_SCHEME=light vitest run --config vitest.critique.config.ts && CRITIQUE_SHOTS=1 CRITIQUE_SCHEME=dark vitest run --config vitest.critique.config.ts",
    "format": "prettier --write src e2e playwright.config.ts",
    "format:check": "prettier --check src e2e playwright.config.ts",
    "test:layout-defects": "CRITIQUE_SCHEME=light VITEST_MAX_WORKERS=8 vitest run --config vitest.critique.config.ts"
  },
  "dependencies": {
    "@highknow/design": "0.3.0",
    "@radix-ui/react-dismissable-layer": "1.2.1",
    "@radix-ui/react-focus-scope": "1.3.1",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-virtual": "3.14.26",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "lucide-react": "1.70.0",
    "react": "^19.3.1",
    "react-diff-view": "3.3.3",
    "react-dom": "^19.3.1",
    "refractor": "5.0.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "jsdom": "31.0.0",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "5.1.0"
  }
}
