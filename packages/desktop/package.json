{
  "name": "flywheel-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.browser-tests.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:dark": "vitest run --config vitest.browser.dark.config.ts",
    "test:browser:motion": "vitest run --config vitest.browser.motion.config.ts",
    "test:browser:forced-colors": "vitest run --config vitest.browser.forced-colors.config.ts",
    "test:critique": "CRITIQUE_SHOTS=1 CRITIQUE_SCHEME=light vitest run --config vitest.critique.config.ts && CRITIQUE_SHOTS=1 CRITIQUE_SCHEME=dark vitest run --config vitest.critique.config.ts",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test:layout-defects": "CRITIQUE_SCHEME=light vitest run --config vitest.critique.config.ts"
  },
  "dependencies": {
    "@highknow/design": "0.1.0",
    "@radix-ui/react-dismissable-layer": "1.2.1",
    "@radix-ui/react-focus-scope": "1.3.1",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-virtual": "3.14.20",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "lucide-react": "1.61.0",
    "react": "^19.3.1",
    "react-diff-view": "3.3.3",
    "react-dom": "^19.3.1",
    "refractor": "5.0.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  }
}
