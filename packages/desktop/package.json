{
  "name": "desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.browser-tests.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:dark": "vitest run --config vitest.browser.dark.config.ts",
    "test:browser:motion": "vitest run --config vitest.browser.motion.config.ts",
    "test:browser:forced-colors": "vitest run --config vitest.browser.forced-colors.config.ts",
    "test:critique": "CRITIQUE_SHOTS=1 CRITIQUE_SCHEME=light vitest run --config vitest.critique.config.ts && CRITIQUE_SHOTS=1 CRITIQUE_SCHEME=dark vitest run --config vitest.critique.config.ts",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test:layout-defects": "CRITIQUE_SCHEME=light vitest run --config vitest.critique.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@radix-ui/react-dismissable-layer": "1.2.1",
    "@radix-ui/react-focus-scope": "1.3.1",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-virtual": "3.14.11",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.43.0",
    "radix-ui": "1.8.1",
    "react": "^19.1.0",
    "react-diff-view": "3.3.3",
    "react-dom": "^19.1.0",
    "refractor": "5.0.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.7.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser": "5.0.0",
    "@vitest/browser-playwright": "5.0.0",
    "jsdom": "30.0.1",
    "playwright": "1.63.0",
    "prettier": "3.9.10",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "5.0.0"
  }
}
