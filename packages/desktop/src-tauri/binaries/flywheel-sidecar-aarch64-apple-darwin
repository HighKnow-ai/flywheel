#!/usr/bin/env bash
# Dev-time sidecar stub (plan 02-01 Task 1 deviation — see SUMMARY.md "Deviations from Plan").
#
# `tauri-plugin-shell`'s sidecar mechanism requires a real, per-target-triple executable to exist
# at `bundle.externalBin`'s path at build time (`tauri_build::build()` fails the whole workspace
# build otherwise, not merely at `tauri build`/bundle time). This repository does not yet have a
# packaging step that compiles `packages/sidecar` into a self-contained binary via `pkg`/`nexe`
# (STACK.md's "Development Tools" row names that as a *future* requirement, for actual app
# distribution — not something this phase's tracer slice needs to prove the architecture).
#
# This script is the interim bridge: it execs the real, TypeScript-built sidecar
# (`packages/sidecar/dist/index.js`) via the developer's own Node install. Replace this with a
# real `pkg`/`nexe`-compiled binary per target triple when the packaging/distribution plan lands.
#
# RESOLUTION RULE (G-02-1): the entrypoint is located by walking up from this script's OWN
# PHYSICAL DIRECTORY (symlinks resolved first) for the `packages/sidecar/dist` marker, execing the
# first ancestor that has it. This rule holds from BOTH locations this file runs from: its
# checked-in location (`packages/desktop/src-tauri/binaries/`) and the location Tauri copies it to
# next to the app executable (`target/<profile>/flywheel-sidecar`). A fixed parent-hop count is
# WRONG here, because the file runs from two different depths — a fixed hop was only ever correct
# from the checked-in location, and from the Tauri-copied location it escaped the repository root
# entirely. Node then exited 1 with MODULE_NOT_FOUND before reading a single request, and the
# failure surfaced far from its cause as "failed to write request to the sidecar's stdin" on the
# first Start Work.
set -euo pipefail

# Resolve BASH_SOURCE[0] to its physical directory, following symlinks one hop at a time via a
# `cd` + `pwd -P` pair on the eventual link target's directory — not `readlink -f`, which is not
# portable to macOS's stock BSD `readlink` (no `-f` flag there). `BASH_SOURCE[0]` can itself be a
# symlink on some install paths, so the walk below must start from where this file physically is,
# not from where a link merely points.
resolve_physical_dir() {
  local target="$1"
  while [ -L "$target" ]; do
    local link
    link="$(readlink "$target")"
    case "$link" in
      /*) target="$link" ;;
      *) target="$(dirname "$target")/$link" ;;
    esac
  done
  (cd "$(dirname "$target")" && pwd -P)
}
SCRIPT_DIR="$(resolve_physical_dir "${BASH_SOURCE[0]}")"

ENTRY=""
dir="$SCRIPT_DIR"
while :; do
  if [ -f "$dir/packages/sidecar/dist/index.js" ]; then
    ENTRY="$dir/packages/sidecar/dist/index.js"
    break
  fi
  [ "$dir" = "/" ] && break
  dir="$(dirname "$dir")"
done

# Refuse an empty resolution, and additionally assert the resolved entrypoint is a regular,
# readable file, before ever reaching `exec` — never fall through to execing an unresolved or
# unreadable path. The walk above only ever assigns ENTRY right after its own `-f` check passed,
# but this is the one belt-and-suspenders check immediately before `exec`, reached whenever no
# marker was found or the resolved path stopped being a readable file between the check and here.
if [ -z "$ENTRY" ] || [ ! -f "$ENTRY" ] || [ ! -r "$ENTRY" ]; then
  echo "flywheel-sidecar: could not find a readable packages/sidecar/dist/index.js by walking up from ${SCRIPT_DIR}." >&2
  echo "flywheel-sidecar: if the sidecar is unbuilt, run: npm --prefix packages/sidecar run build" >&2
  echo "flywheel-sidecar: (this dev stub requires the source tree; a packaged app needs the real pkg/nexe binary.)" >&2
  exit 127
fi

exec node "$ENTRY" "$@"
