#!/usr/bin/env bash
# Dev-time sidecar stub (plan 02-01 Task 1 deviation — see SUMMARY.md "Deviations from Plan").
#
# `tauri-plugin-shell`'s sidecar mechanism requires a real, per-target-triple executable to exist
# at `bundle.externalBin`'s path at build time (`tauri_build::build()` fails the whole workspace
# build otherwise, not merely at `tauri build`/bundle time). This repository does not yet have a
# packaging step that compiles `packages/sidecar` into a self-contained binary via `pkg`/`nexe`
# (STACK.md's "Development Tools" row names that as a *future* requirement, for actual app
# distribution — not something this phase's tracer slice needs to prove the architecture).
#
# This script is the interim bridge: it execs the real, TypeScript-built sidecar
# (`packages/sidecar/dist/index.js`) via the developer's own Node install, resolved relative to
# this script's own location so it works regardless of which machine's absolute path checked this
# repository out. Replace this with a real `pkg`/`nexe`-compiled binary per target triple when the
# packaging/distribution plan lands.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec node "$SCRIPT_DIR/../../../sidecar/dist/index.js" "$@"
