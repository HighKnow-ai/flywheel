{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flywheel",
  "version": "0.1.0",
  "identifier": "com.highknow.flywheel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../../sidecar run build:dist && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Flywheel",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/flywheel-sidecar",
      "binaries/flywheel-node",
      "binaries/flywheel-shim"
    ],
    "createUpdaterArtifacts": true,
    "resources": [
      "resources/sidecar"
    ]
  }
}
