{
  /*
   * The real-browser test arm (`vitest.browser.config.ts`) is typechecked as its OWN program,
   * separate from `tsconfig.json`.
   *
   * Why: `@vitest/browser/jest-dom.d.ts` augments vitest's `Assertion` with its own DOM matchers,
   * and its `toHaveTextContent` accepts `string | number` — no `RegExp`. `@testing-library/jest-dom`
   * (loaded by `src/test/setup.ts` for the jsdom arm) declares the same matcher as
   * `string | RegExp`. With both augmentations in ONE program the `string | number` signature wins
   * for every file, so any jsdom test asserting `toHaveTextContent(/.../i)` fails to compile even
   * though it runs correctly. Keeping the two arms in separate programs lets each see only the
   * matcher augmentation that actually applies to it.
   */
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src/**/*.browser.test.tsx", "src/test"],
  /*
   * Reset, not inherited: `tsconfig.json` excludes every browser test (its own program must not see them),
   * and an inherited `exclude` wins over this `include`, so without this line this program checked none of the
   * browser tests at all. That is how a duplicate-key fixture in `fleet-group.browser.test.tsx` passed the build.
   */
  "exclude": []
}
