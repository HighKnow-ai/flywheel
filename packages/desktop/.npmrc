# A new dependency version is not resolved until it is three days old: the window in which a
# compromised release is usually caught and unpublished. Units are DAYS (npm's `min-release-age`,
# read by npm 11.17, measured; npm 10, which Node 22 bundles, does not know the key and only warns).
# It applies when npm builds a tree (`npm install`, `npm update`); `npm ci` installs the lockfile
# as written. Dependabot's cooldown on this directory is the same three days for minor and patch.
min-release-age=3
