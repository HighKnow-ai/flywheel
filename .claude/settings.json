{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.highknow/**)",
      "Read(~/Library/Keychains/**)",
      "Read(~/.config/gh-*/**)",
      "Read(~/Library/Preferences/.wrangler/config/**)",
      "Read(~/.wrangler/**)",
      "Read(~/.aws/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/**)",
      "Read(~/.terraform.d/**)",
      "Read(~/.config/anthropic/**)",
      "Read(~/.config/configstore/**)",
      "Read(~/.config/rclone/**)",
      "Read(~/.config/sentry/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.sentryclirc)",
      "Read(~/.cargo/credentials.toml)",
      "Read(~/.claude.json)",
      "Read(~/.zsh_history)",
      "Read(~/.bash_history)",
      "Read(~/.local/share/atuin/**)",
      "Edit(./.claude/**)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.config/gh",
        "~/.config/gcloud",
        "~/.highknow",
        "~/Library/Keychains",
        "~/.config/gh-*",
        "~/Library/Preferences/.wrangler/config",
        "~/.wrangler",
        "~/.aws",
        "~/.docker/config.json",
        "~/.kube",
        "~/.terraform.d",
        "~/.config/anthropic",
        "~/.config/configstore",
        "~/.config/rclone",
        "~/.config/sentry",
        "~/.gnupg",
        "~/.npmrc",
        "~/.netrc",
        "~/.git-credentials",
        "~/.sentryclirc",
        "~/.cargo/credentials.toml",
        "~/.claude.json",
        "~/.zsh_history",
        "~/.bash_history",
        "~/.local/share/atuin"
      ],
      "allowWrite": [
        "~/Library/pnpm",
        "~/Library/Caches/pnpm",
        "~/.local/state/pnpm",
        "~/.local/state/mise/trusted-configs",
        "~/.local/state/mise/tracked-configs",
        "~/.npm",
        "~/.cargo/registry",
        "~/.cargo/git"
      ]
    },
    "network": {
      "allowedDomains": ["github.com", "api.github.com", "registry.npmjs.org", "index.crates.io", "static.crates.io"],
      "deniedDomains": ["telemetry.vercel.com"],
      "allowLocalBinding": true
    }
  }
}
